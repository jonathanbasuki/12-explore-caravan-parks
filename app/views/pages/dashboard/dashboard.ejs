<% layout('layouts/main') %>
    <%- include('../../partials/navbar') %>

        <!-- Hero Section with Image Background -->
        <section class="relative min-h-screen bg-cover bg-center bg-no-repeat"
            style="background-image: url('/images/hero.jpg');">
            <div class="absolute inset-0 bg-black/50 z-0"></div> <!-- Black overlay -->

            <!-- Dashboard Content -->
            <div class="relative z-10 py-12 px-6 pt-24">
                <div class="max-w-7xl mx-auto text-white">
                    <h1 class="text-3xl font-bold text-white mb-6">Dashboard</h1>

                    <!-- Grid Layout for Booking, Payment, and Wishlist -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">

                        <!-- Booking History Section -->
                        <div class="text-white p-6 rounded-lg shadow-md backdrop-blur-sm bg-white/10">
                            <h2 class="text-xl font-semibold mb-4">Booking History</h2>
                            <div class="space-y-4">
                                <div class="flex justify-between">
                                    <span class="text-sm">Beautiful Camp Lake Front</span>
                                    <span class="text-sm">12/10/2023</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-sm">Cozy Tent by the Lake</span>
                                    <span class="text-sm">05/15/2024</span>
                                </div>
                                <a href="/dashboard/booking-history"
                                    class="text-base flex items-center gap-2 text-[var(--burnt-orange-text)] hover:text-[var(--burnt-orange-text-hover)] mt-4">View
                                    all bookings
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                        stroke-width="1.5" stroke="currentColor"
                                        class="w-4 h-4 md:w-5 md:h-5 text-current">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
                                    </svg>
                                </a>
                            </div>
                        </div>

                        <!-- Payment History Section -->
                        <div class="text-white p-6 rounded-lg shadow-md backdrop-blur-sm bg-white/10">
                            <h2 class="text-xl font-semibold mb-4">Payment History</h2>
                            <div class="space-y-4">
                                <div class="flex justify-between">
                                    <span class="text-sm">Booking: Beautiful Camp Lake Front</span>
                                    <span class="text-sm">$150</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-sm">Booking: Cozy Tent by the Lake</span>
                                    <span class="text-sm">$200</span>
                                </div>
                                <a href="/dashboard/payment-history"
                                    class="text-base flex items-center gap-2 text-[var(--burnt-orange-text)] hover:text-[var(--burnt-orange-text-hover)] mt-4">View
                                    all payments
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                        stroke-width="1.5" stroke="currentColor"
                                        class="w-4 h-4 md:w-5 md:h-5 text-current">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
                                    </svg>
                                </a>
                            </div>
                        </div>

                        <!-- Wishlist Section -->
                        <div class="text-white p-6 rounded-lg shadow-md backdrop-blur-sm bg-white/10">
                            <h2 class="text-xl font-semibold mb-4">Wishlist</h2>
                            <div class="space-y-4">
                                <div class="flex justify-between">
                                    <span class="text-sm">Mountain View Glamping</span>
                                    <button
                                        class="text-[var(--burnt-orange-text)] hover:text-[var(--burnt-orange-text-hover)]">Remove</button>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-sm">Lakeside Luxury Tents</span>
                                    <button
                                        class="text-[var(--burnt-orange-text)] hover:text-[var(--burnt-orange-text-hover)]">Remove</button>
                                </div>
                                <a href="/dashboard/saved-campgrounds"
                                    class="text-base flex items-center gap-2 text-[var(--burnt-orange-text)] hover:text-[var(--burnt-orange-text-hover)] mt-4">View
                                    all wishlist items
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                        stroke-width="1.5" stroke="currentColor"
                                        class="w-4 h-4 md:w-5 md:h-5 text-current">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
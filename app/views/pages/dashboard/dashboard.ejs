<% layout('layouts/main') %>
    <%- include('../../partials/navbar') %>

        <!-- Hero Section with Image Background -->
        <section class="relative min-h-screen bg-cover bg-center bg-no-repeat"
            style="background-image: url('/images/hero.jpg');">
            <div class="absolute inset-0 bg-black/50 z-0"></div> <!-- Black overlay -->

            <!-- Dashboard Content -->
            <div class="relative z-10 py-12 px-6 pt-24">
                <div class="max-w-7xl mx-auto text-white">
                    <h1 class="text-3xl font-bold text-white mb-6">Dashboard</h1>

                    <!-- Grid Layout for Booking, Payment, and Wishlist -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">

                        <!-- Booking History Section -->
                        <div class="text-white p-6 rounded-lg shadow-md backdrop-blur-sm bg-white/10">
                            <h2 class="text-xl font-semibold mb-4">Booking History</h2>
                            <div class="space-y-4">
                                <% if (booking_history.length> 0) { %>
                                    <% booking_history.forEach((booking)=> { %>
                                        <div class="flex justify-between items-start border-t border-white/20 pt-2">
                                            <span class="text-sm truncate max-w-[75%] block">
                                                <%= booking.campground_name %>
                                            </span>
                                            <span class="text-sm text-gray-300 whitespace-nowrap">
                                                <%= new Date(booking.check_in).toLocaleDateString('id-ID') %>
                                            </span>
                                        </div>
                                        <% }) %>

                                            <a href="/dashboard/booking-history"
                                                class="text-base flex items-center gap-2 text-[var(--burnt-orange-text)] hover:text-[var(--burnt-orange-text-hover)] mt-4 border-t border-white/20 pt-2">
                                                View all bookings
                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                    class="w-4 h-4 md:w-5 md:h-5 text-current" fill="none"
                                                    viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
                                                </svg>
                                            </a>
                                            <% } else { %>
                                                <p class="text-sm text-gray-300 border-t border-white/20 pt-2">No
                                                    bookings found.</p>
                                                <% } %>


                            </div>
                        </div>

                        <!-- Review History Section -->
                        <div class="text-white p-6 rounded-lg shadow-md backdrop-blur-sm bg-white/10">
                            <h2 class="text-xl font-semibold mb-4">Review History</h2>
                            <div class="space-y-4">
                                <% if (review_history.length> 0) { %>
                                    <% review_history.forEach((review)=> { %>
                                        <div class="flex flex-col border-t border-white/20 pt-2">
                                            <span class="text-sm font-semibold truncate">
                                                <%= review.campground_name %>
                                            </span>
                                            <div class="flex justify-between items-start">
                                                <span class="text-sm truncate max-w-[75%] block">
                                                    <%= review.comment %>
                                                </span>
                                                <span class="text-sm text-gray-300 whitespace-nowrap">
                                                    <%= new Date(review.date).toLocaleDateString('id-ID') %>
                                                </span>
                                            </div>
                                        </div>
                                        <% }) %>

                                            <a href="/dashboard/review-history"
                                                class="text-base flex items-center gap-2 text-[var(--burnt-orange-text)] hover:text-[var(--burnt-orange-text-hover)] mt-4 border-t border-white/20 pt-2">
                                                View all reviews
                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                    class="w-4 h-4 md:w-5 md:h-5 text-current" fill="none"
                                                    viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
                                                </svg>
                                            </a>
                                            <% } else { %>
                                                <p class="text-sm text-gray-300 border-t border-white/20 pt-2">No
                                                    reviews found.</p>
                                                <% } %>
                            </div>
                        </div>

                        <!-- Wistlist Section -->
                        <div class="text-white p-6 rounded-lg shadow-md backdrop-blur-sm bg-white/10">
                            <h2 class="text-xl font-semibold mb-4">Wishlist</h2>
                            <div class="space-y-4">
                                <% if (saved_history.length> 0) { %>
                                    <% saved_history.forEach((wishlist)=> { %>
                                        <div class="flex justify-between items-start border-t border-white/20 pt-2">
                                            <span class="text-sm truncate max-w-[75%] block">
                                                <%= wishlist.campground_name %>
                                            </span>
                                            <span class="text-sm text-gray-300 whitespace-nowrap">
                                                <form action="/saved/<%= wishlist.campground_id %>?_method=DELETE" method="POST"
                                                    class="inline-flex">
                                                    <button type="submit"
                                                        class="text-[var(--burnt-orange-text)] hover:text-[var(--burnt-orange-text-hover)]">
                                                        Remove
                                                    </button>
                                                </form>
                                            </span>
                                        </div>
                                        <% }) %>

                                            <a href="/dashboard/saved-campgrounds"
                                                class="text-base flex items-center gap-2 text-[var(--burnt-orange-text)] hover:text-[var(--burnt-orange-text-hover)] mt-4 border-t border-white/20 pt-2">
                                                View all wishlist items
                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                    class="w-4 h-4 md:w-5 md:h-5 text-current" fill="none"
                                                    viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
                                                </svg>
                                            </a>
                                            <% } else { %>
                                                <p class="text-sm text-gray-300 border-t border-white/20 pt-2">No saved
                                                    campgrounds yet.</p>
                                                <% } %>


                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
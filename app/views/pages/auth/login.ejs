<% layout('layouts/main') %>

    <div class="relative min-h-screen bg-cover bg-center" style="background-image: url('/images/hero.jpg')">
        <!-- Dark overlay for contrast -->
        <div class="absolute inset-0 bg-opacity-40"></div>

        <div class="relative z-10 flex min-h-screen items-center justify-center px-6 py-12">
            <!-- Glassmorphism card -->
            <div
                class="bg-white/20 backdrop-blur-md rounded-2xl shadow-2xl p-10 w-full max-w-md border border-white/20">
                <div class="text-center">
                    <a href="/">
                        <img class="mx-auto h-20 w-auto" src="/images/logo.png" alt="Your Company" />
                    </a>
                    <h2 class="mt-6 text-2xl font-bold tracking-tight text-white">Sign in to your account</h2>
                </div>

                <form class="mt-8 space-y-6" action="/login" method="POST">
                    <%- include('../../partials/success_flash') %>

                        <% if (error) { %>
                            <div id="flash-message"
                                class="bg-red-500/10 text-red-100 border border-red-500/30 px-4 py-2 rounded-md text-sm">
                                <%= error %>
                            </div>
                            <% } %>

                                <div>
                                    <label for="identifier"
                                        class="block text-sm font-medium text-white">Username</label>
                                    <input id="identifier" name="identifier" type="text" autocomplete="identifier"
                                        required
                                        class="mt-1 block w-full rounded-md border-white/30 bg-white/10 px-3 py-2 text-white placeholder-white/70 focus:outline-none focus:ring-2 focus:ring-[var(--burnt-orange)] sm:text-sm" />
                                </div>

                                <div>
                                    <label for="password" class="block text-sm font-medium text-white">Password</label>
                                    <input id="password" name="password" type="password" autocomplete="current-password"
                                        required
                                        class="mt-1 block w-full rounded-md border-white/30 bg-white/10 px-3 py-2 text-white placeholder-white/70 focus:outline-none focus:ring-2 focus:ring-[var(--burnt-orange)] sm:text-sm" />
                                </div>

                                <div class="flex items-center justify-between">
                                    <a href="/forgot-password"
                                        class="text-sm font-medium text-[var(--burnt-orange-text)] hover:text-[var(--burnt-orange-text-hover)]">Forgot
                                        password?</a>
                                </div>

                                <div>
                                    <button type="submit"
                                        class="mt-4 w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-white bg-[var(--burnt-orange)] hover:bg-[var(--burnt-orange-hover)] text-sm font-medium focus:outline-none focus:ring-2 focus:ring-[var(--burnt-orange)]">
                                        Sign in
                                    </button>
                                </div>
                </form>

                <p class="mt-6 text-center text-sm text-white/80">
                    Don't have an account?
                    <a href="/register"
                        class="font-medium text-[var(--burnt-orange-text)] hover:text-[var(--burnt-orange-text-hover)]">Register</a>
                </p>
            </div>
        </div>
    </div>
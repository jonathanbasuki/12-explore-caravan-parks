<% layout('layouts/main') %>
    <%- include('../../partials/navbar') %>

        <!-- Hero Section -->
        <div class="relative w-full h-[500px]">
            <img src="<%= campground.media_urls[0] || '/images/hero.jpg' %>" alt="Campground"
                class="absolute inset-0 w-full h-full object-cover z-0">
            <div class="absolute inset-0 bg-black/50 z-10"></div>
            <div class="relative z-20 max-w-7xl mx-auto h-full flex flex-col justify-center px-6 md:px-12 pt-24">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between">
                    <div>
                        <h1 class="text-4xl font-bold text-white mb-3">
                            <%= campground.name %>
                        </h1>
                        <p class="text-lg text-gray-200">
                            <%= campground.address %>
                        </p>
                        <% if (isAuthenticated) { %>
                            <% if (isSaved) { %>
                                <!-- REMOVE from Wishlist -->
                                <form action="/saved/<%= campground.id %>?_method=DELETE" method="POST"
                                    class="inline-flex">
                                    <button type="submit" class="mt-4 md:mt-0 inline-flex items-center gap-2 hover:bg-white text-white
                                        font-semibold px-4 py-2 rounded shadow transition border border-white hover:text-black
                                        hover:border-white">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                            stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                d="M6 18L18 6M6 6l12 12" />
                                        </svg>
                                        Remove from Wishlist
                                    </button>
                                </form>
                                <% } else { %>
                                    <!-- SAVE to Wishlist -->
                                    <form action="/saved" method="POST" class="inline-flex">
                                        <input type="hidden" name="campground_id" value="<%= campground.id %>" />
                                        <button type="submit" class="mt-4 md:mt-0 inline-flex items-center gap-2 hover:bg-black text-white
                                        font-semibold px-4 py-2 rounded shadow transition border border-white
                                        hover:border-black">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                                stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                    d="M11.48 3.499a5.5 5.5 0 017.772 7.772L12 18.52l-7.25-7.25a5.5 5.5 0 017.73-7.772z" />
                                            </svg>
                                            Save to Wishlist
                                        </button>
                                    </form>
                                    <% } %>
                                        <% } else { %>
                                            <a href="/login"
                                                class="mt-4 md:mt-0 inline-flex items-center gap-2 hover:bg-black text-white font-semibold px-4 py-2 rounded shadow transition border border-white hover:border-black">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                                    stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        d="M11.48 3.499a5.5 5.5 0 017.772 7.772L12 18.52l-7.25-7.25a5.5 5.5 0 017.73-7.772z" />
                                                </svg>
                                                Login to Save
                                            </a>
                                            <% } %>

                    </div>
                </div>
            </div>
        </div>

        <section class="bg-gray-50 py-12 px-6">
            <div class="max-w-7xl mx-auto md:flex md:space-x-10">

                <!-- Left: Description & Gallery -->
                <div class="md:w-2/3 space-y-10">
                    <!-- Description -->
                    <div>
                        <h2 class="text-2xl font-semibold text-gray-800 mb-2">About This Campground</h2>
                        <p class="text-gray-600 leading-relaxed">
                            <%= campground.description || 'No description available.' %>
                        </p>
                    </div>

                    <!-- Photo Gallery -->
                    <div>
                        <h2 class="text-xl font-semibold text-gray-800 mb-4">Photos</h2>
                        <% if (campground.media_urls && campground.media_urls.length> 0) { %>
                            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                                <% campground.media_urls.forEach(function(photo) { %>
                                    <img src="<%= photo %>" class="w-full h-40 object-cover rounded-lg" />
                                    <% }); %>
                            </div>
                            <% } else { %>
                                <div class="bg-white p-4 rounded shadow">
                                    <p class="font-medium text-gray-800">No photo available.</p>
                                    </p>
                                </div>
                                <% } %>
                    </div>

                    <!-- Review Section -->
                    <div>
                        <h2 class="text-xl font-semibold text-gray-800 mb-4">Reviews</h2>

                        <!-- Existing reviews -->
                        <div class="space-y-4">
                            <% if (reviews.length> 0) { %>
                                <% reviews.forEach(function(review) { %>
                                    <div class="bg-white p-4 rounded shadow">
                                        <div class="flex items-center justify-between mb-2">
                                            <p class="font-medium text-gray-800">User</p>
                                            <div class="flex text-yellow-400">
                                                <% for (let i=0; i < review.rating; i++) { %>
                                                    <span>★</span>
                                                    <% } %>
                                                        <% for (let i=0; i < 5 - review.rating; i++) { %>
                                                            <span>☆</span>
                                                            <% } %>
                                            </div>
                                        </div>
                                        <p class="text-gray-600">
                                            <%= review.comment %>
                                        </p>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <div class="bg-white p-4 rounded shadow">
                                                <p class="font-medium text-gray-800">No review available.</p>
                                            </div>
                                            <% } %>
                        </div>

                        <!-- Leave a review -->
                        <% if (isAuthenticated) { %>
                            <!-- Form submit review -->
                            <form action="/reviews/" method="POST" class="mt-6 bg-white p-4 rounded shadow space-y-3">
                                <h3 class="text-lg font-semibold text-gray-800">Leave a Review</h3>
                                <input type="hidden" name="campground_id" value="<%= campground.id %>">
                                <textarea name="comment" rows="3" placeholder="Write your review..."
                                    class="w-full border px-3 py-2 rounded text-gray-800"></textarea>
                                <div>
                                    <label class="block text-sm text-gray-600 mb-1">Rating</label>
                                    <select name="rating" class="w-full border rounded px-3 py-2 text-gray-800">
                                        <option value="5.0">★★★★★ - Excellent</option>
                                        <option value="4.0">★★★★☆ - Good</option>
                                        <option value="3.0">★★★☆☆ - Okay</option>
                                        <option value="2.0">★★☆☆☆ - Poor</option>
                                        <option value="1.0">★☆☆☆☆ - Terrible</option>
                                    </select>
                                </div>
                                <button type="submit"
                                    class="bg-[#BF5B04] hover:bg-[#a44a03] text-white px-4 py-2 rounded font-semibold">
                                    Submit Review
                                </button>
                            </form>
                            <% } else { %>
                                <!-- Jika belum login, arahkan ke login -->
                                <form action="/login" method="GET" class="mt-6 bg-white p-4 rounded shadow space-y-3">
                                    <h3 class="text-lg font-semibold text-gray-800">Login to Leave a Review</h3>
                                    <input type="text" placeholder="Your name" disabled
                                        class="w-full border px-3 py-2 rounded text-gray-400 bg-gray-100 cursor-not-allowed" />
                                    <textarea rows="3" placeholder="Write your review..." disabled
                                        class="w-full border px-3 py-2 rounded text-gray-400 bg-gray-100 cursor-not-allowed"></textarea>
                                    <div>
                                        <label class="block text-sm text-gray-600 mb-1">Rating</label>
                                        <select
                                            class="w-full border rounded px-3 py-2 text-gray-400 bg-gray-100 cursor-not-allowed"
                                            disabled>
                                            <option>★★★★★ - Excellent</option>
                                        </select>
                                    </div>
                                    <button type="submit"
                                        class="bg-[#BF5B04] hover:bg-[#a44a03] text-white px-4 py-2 rounded font-semibold">
                                        Login to Submit Review
                                    </button>
                                </form>
                                <% } %>
                    </div>

                </div>

                <!-- Right: Booking Form + Map -->
                <div class="md:w-1/3 mt-10 md:mt-0 space-y-10">
                    <!-- Booking Form -->
                    <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200 space-y-4">
                        <h2 class="text-lg font-semibold text-gray-800">Book Your Stay</h2>

                        <% if (isAuthenticated) { %>
                            <!-- Form Booking untuk user yang sudah login -->
                            <form action="/booking" method="POST" class="space-y-4 mt-4">
                                <div>
                                    <label class="block text-sm text-gray-600">Check-in</label>
                                    <input type="date" name="checkin"
                                        class="w-full mt-1 border rounded px-3 py-2 text-gray-800" required>
                                </div>
                                <div>
                                    <label class="block text-sm text-gray-600">Check-out</label>
                                    <input type="date" name="checkout"
                                        class="w-full mt-1 border rounded px-3 py-2 text-gray-800" required>
                                </div>
                                <button type="submit"
                                    class="w-full bg-[#BF5B04] hover:bg-[#a44a03] text-white font-semibold py-2 rounded">
                                    Book Now
                                </button>
                            </form>
                            <% } else { %>
                                <!-- Jika belum login, arahkan ke halaman login -->
                                <form action="/login" method="GET" class="space-y-4 mt-4">
                                    <div>
                                        <label class="block text-sm text-gray-600">Check-in</label>
                                        <input type="date"
                                            class="w-full mt-1 border rounded px-3 py-2 text-gray-400 bg-gray-100 cursor-not-allowed"
                                            disabled>
                                    </div>
                                    <div>
                                        <label class="block text-sm text-gray-600">Check-out</label>
                                        <input type="date"
                                            class="w-full mt-1 border rounded px-3 py-2 text-gray-400 bg-gray-100 cursor-not-allowed"
                                            disabled>
                                    </div>
                                    <button type="submit"
                                        class="w-full bg-[#BF5B04] hover:bg-[#a44a03] text-white font-semibold py-2 rounded">
                                        Login to Book
                                    </button>
                                </form>
                                <% } %>
                    </div>

                    <!-- Map -->
                    <div>
                        <h2 class="text-lg font-semibold text-gray-800 mb-2">Location</h2>
                        <div class="w-full h-72 rounded overflow-hidden">
                            <iframe class="w-full h-full" frameborder="0"
                                src="https://www.google.com/maps/embed/v1/place?key=<%= process.env.MAPS_API_KEY %>&q=<%= campground.latitute %>,<%= campground.longitude %>&zoom=13"
                                allowfullscreen>
                            </iframe>
                        </div>
                    </div>

                </div>
            </div>
        </section>
<% layout('layouts/main') %>

    <%- include('../../partials/navbar') %>

        <section class="relative h-screen w-full bg-cover bg-center bg-no-repeat flex items-center justify-center"
            style="background-image: url('/images/hero.jpg')">

            <!-- Gradient overlay -->
            <div class="absolute inset-0 bg-black/60 z-0"></div>

            <!-- Content -->
            <div class="relative z-10 mx-auto w-screen max-w-screen-xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-32">
                <div class="mx-auto max-w-prose text-center">
                    <h1 class="text-4xl font-bold text-white sm:text-5xl">
                        About Campervan Explorer
                    </h1>

                    <p class="mt-4 text-base text-white sm:text-lg/relaxed">
                        Campervan Explorer is a web application that helps caravan travelers discover, and reserve the perfect spot. Built with Express JS, the platform
                        streamlines your journey from browsing to booking.
                    </p>

                    <div class="mt-4 flex justify-center gap-4 sm:mt-6">
                        <a class="inline-block rounded border-[var(--burnt-orange)] bg-[var(--burnt-orange)] px-5 py-3 font-medium text-white shadow-sm transition-colors hover:bg-[var(--burnt-orange-hover)]"
                            href="https://github.com/jonathanbasuki/12-explore-caravan-parks" target="_blank">
                            View on GitHub
                        </a>

                        <a class="inline-block rounded border border-white px-5 py-3 font-medium text-white shadow-sm transition-colors hover:bg-white hover:text-gray-900"
                            href="https://campervan-explorer-api-docs.com/swagger" target="_blank">
                            API Docs (Swagger)
                        </a>
                    </div>

                </div>
            </div>
            </div>
        </section>